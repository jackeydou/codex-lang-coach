{
  "name": "@language-coach/worker",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "tsc -p tsconfig.json --noEmit",
    "deploy": "pnpm --filter @language-coach/dashboard build && wrangler deploy",
    "dev": "pnpm --filter @language-coach/dashboard build && wrangler dev",
    "migrate:production": "node scripts/migrate-production.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@language-coach/core": "workspace:*",
    "jose": "6.2.10",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@language-coach/dashboard": "workspace:*",
    "@types/pg": "8.23.1",
    "wrangler": "^4.127.1"
  }
}
