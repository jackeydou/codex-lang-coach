{
  "description": "Inject language coaching and selectively save useful learning notes.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit.mjs\"",
            "statusMessage": "Loading your language coach"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/stop.mjs\"",
            "statusMessage": "Saving your language note",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
