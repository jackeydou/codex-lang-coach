{
  "description": "Inject language coaching and selectively save useful learning notes.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${PLUGIN_ROOT}/runtime/run-node.sh\" \"${PLUGIN_ROOT}/hooks/user-prompt-submit.mjs\"",
            "statusMessage": "Loading your language coach"
          }
        ]
      }
    ]
  }
}
